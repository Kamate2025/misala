DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=portfolio.kamategroup.online,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://portfolio.kamategroup.online,http://localhost:8014
DJANGO_CORS_ALLOWED_ORIGINS=https://portfolio.kamategroup.online,http://localhost:5173,http://localhost:8014

# Only needed when running in Docker (points at the mounted sqlite_data
# volume so the database survives `docker compose down`). Leave unset for
# a plain local run — it then defaults to backend/db.sqlite3.
# SQLITE_PATH=/app/data/db.sqlite3
